# Copie ce fichier en ".env" et remplis avec tes vrais identifiants vSphere.
# Convention : VSPHERE_<CODE_BACKEND>_HOST / _USER / _PASSWORD

VSPHERE_DC1_HOST=vcenter-dc1.laposte.fr
VSPHERE_DC1_USER=svc-placement@vsphere.local
VSPHERE_DC1_PASSWORD=change-me

# Autre backend éventuel :
# VSPHERE_DC2_HOST=vcenter-dc2.laposte.fr
# VSPHERE_DC2_USER=svc-placement@vsphere.local
# VSPHERE_DC2_PASSWORD=change-me

# Durée de vie du cache d'inventaire, en secondes (1800 = 30 min, recommandé
# si ton scan initial prend du temps sur une grosse infra)
INVENTORY_CACHE_TTL=1800

# true = scan optimisé PropertyCollector (recommandé, rapide)
# false = scan classique (un appel réseau par host/VM, plus lent)
INVENTORY_SCAN_OPTIMIZED=true
